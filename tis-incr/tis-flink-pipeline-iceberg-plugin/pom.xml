<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.qlangtech.tis.plugins</groupId>
        <artifactId>tis-incr-iceberg</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>tis-flink-pipeline-iceberg-plugin</artifactId>
    <packaging>tpi</packaging>

    <name>TIS Flink Pipeline Iceberg Plugin</name>
    <description>Flink pipeline plugin for Apache Iceberg streaming</description>

    <properties>
        <classifier>hive_${hive.version};hadoop_${hadoop-version}</classifier>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.qlangtech.tis.plugins</groupId>
            <artifactId>tis-scala-compiler</artifactId>
        </dependency>

        <dependency>
            <groupId>com.qlangtech.tis.plugins</groupId>
            <artifactId>tis-incr-test</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- TIS Flink 基础依赖 -->
        <dependency>
            <groupId>com.qlangtech.tis.plugins</groupId>
            <artifactId>tis-realtime-flink</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>com.google.protobuf</groupId>
                    <artifactId>protobuf-java</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- TIS 定制的 flink-cdc Iceberg 连接器：jar 内已经 shade 了 org/apache/iceberg/flink/**
             与 org/apache/flink/cdc/**，因此它自带的 iceberg-flink / iceberg-core 传递依赖必须排除，
             否则 WEB-INF/lib 里会同时出现「connector 内的 flink 集成类」和「iceberg-flink 原 jar」，
             iceberg core 更会与 tis-datax-icebergwriter-plugin 里那份撞成两个类身份
             （paimon 插件踩过同样的坑）。iceberg 全栈统一由 writer 插件提供 -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-cdc-pipeline-connector-iceberg-tis</artifactId>
            <version>${flink.cdc.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.iceberg</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- IcebergCatalog 与各文件格式（IcebergFileFormat/Parquet/ORC/Avro）与 DataX 写入插件共用同一份实现，
             避免两侧各维护一套压缩编码与表属性。打了 tpi 的依赖会被 MavenArtifact.isPlugin() 识别为
             插件依赖（不进 WEB-INF/lib，只写进 Plugin-Dependencies），因此运行时需要同时安装该插件 -->
        <dependency>
            <groupId>com.qlangtech.tis.plugins</groupId>
            <artifactId>tis-datax-icebergwriter-plugin</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Apache Iceberg 核心依赖：只在编译期可见（运行时由 tis-datax-icebergwriter-plugin
             的 WEB-INF/lib 提供，见上面的 Plugin-Dependencies）。
             scope 必须是 provided，否则 maven-tpi-plugin 会把它们再打一份进本插件的 WEB-INF/lib；
             两份同名 iceberg 类分属不同 PluginFirstClassLoader 时，跨 loader 传 Table/Catalog
             就会 LinkageError -->
        <dependency>
            <groupId>org.apache.iceberg</groupId>
            <artifactId>iceberg-core</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.iceberg</groupId>
            <artifactId>iceberg-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.iceberg</groupId>
            <artifactId>iceberg-data</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Iceberg Catalog 实现 -->
        <dependency>
            <groupId>org.apache.iceberg</groupId>
            <artifactId>iceberg-hive-metastore</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.iceberg</groupId>
            <artifactId>iceberg-aws</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Flink CDC（已在 tis-flink-extends 中加载） -->
        <dependency>
            <artifactId>flink-cdc-common</artifactId>
            <groupId>org.apache.flink</groupId>
            <version>${flink.cdc.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>com.qlangtech.tis</groupId>
                <artifactId>maven-tpi-plugin</artifactId>
                <configuration>
                    <maskClasses>org.apache.hadoop.</maskClasses>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
